#include "F2837xD_Cla_defines.h"
#include "F28x_Project.h"
#include <stdint.h>
#include "Defines.h"
#include "cla_prog.h"

#pragma DATA_SECTION(ADC_filt,"Cla1ToCpuMsgRAM");
volatile ADC_filt_t ADC_filt;

#if (ALLOW_VOLT_MOV_MEAN == 1)
uint32_t volt_mov_mean[4][4];
#pragma DATA_SECTION(mov_mean_index, "CLADataLS0")
uint16_t mov_mean_index;
#endif
uint16_t ADC_history[8][ADC_PWM_RAT];



#if (TRIMMED_MEAN_ADC == 1)
#pragma CODE_SECTION(update_min_max, "Cla1Prog")
void update_min_max (uint16_t index, uint16_t var_index)
{
    if ((ADC_history[var_index][index]) < ADC_filt.min1[var_index]) {                                                
        ADC_filt.min2[var_index] = ADC_filt.min1[var_index];                                            
        ADC_filt.min1[var_index] = (ADC_history[var_index][index]);                                                  
    } else if ((ADC_history[var_index][index]) < ADC_filt.min2[var_index]) {                                         
        ADC_filt.min2[var_index] = (ADC_history[var_index][index]);                                                  
    }                                                                         
    if ((ADC_history[var_index][index]) > ADC_filt.max1[var_index]) {                                                
        ADC_filt.max2[var_index] = ADC_filt.max1[var_index];                                            
        ADC_filt.max1[var_index] = (ADC_history[var_index][index]);                                                  
    } else if ((ADC_history[var_index][index]) > ADC_filt.max2[var_index]) {                                         
        ADC_filt.max2[var_index] = (ADC_history[var_index][index]);                                                  
    }
    
}
#endif

//static uint16_t i_old;

static uint32_t mov_mean(uint32_t* val_array)
{
    return 0.25*(val_array[0] + val_array[1] + val_array[2] + val_array[3]);
    //return 0.25*(val_array[0] + val_array[1] + val_array[2] + val_array[3] +
      //      val_array[4] + val_array[5] + val_array[6] + val_array[7]);
}

