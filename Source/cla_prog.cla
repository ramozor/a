    ADC_filt.sum[ADC_CELL2_CUR_INDEX] -= ADC_history[ADC_CELL2_CUR_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL1_CUR_INDEX] -= ADC_history[ADC_CELL1_CUR_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL3_CUR_INDEX] -= ADC_history[ADC_CELL3_CUR_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL4_CUR_INDEX] -= ADC_history[ADC_CELL4_CUR_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL1_VOLT_INDEX] -= ADC_history[ADC_CELL1_VOLT_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL2_VOLT_INDEX] -= ADC_history[ADC_CELL2_VOLT_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL3_VOLT_INDEX] -= ADC_history[ADC_CELL3_VOLT_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL4_VOLT_INDEX] -= ADC_history[ADC_CELL4_VOLT_INDEX][ADC_filt.i_sample];
    //Second only history
    ADC_history[ADC_CELL2_CUR_INDEX][ADC_filt.i_sample] =  ADC_CELL2_CUR_RES;
    ADC_history[ADC_CELL1_CUR_INDEX][ADC_filt.i_sample] =  ADC_CELL1_CUR_RES;
    ADC_history[ADC_CELL3_CUR_INDEX][ADC_filt.i_sample] =  ADC_CELL3_CUR_RES;
    ADC_history[ADC_CELL4_CUR_INDEX][ADC_filt.i_sample] =  ADC_CELL4_CUR_RES;
    ADC_history[ADC_CELL1_VOLT_INDEX][ADC_filt.i_sample] =  ADC_CELL1_VOLT_RES;
    ADC_history[ADC_CELL2_VOLT_INDEX][ADC_filt.i_sample] =  ADC_CELL2_VOLT_RES;
    ADC_history[ADC_CELL3_VOLT_INDEX][ADC_filt.i_sample] =  ADC_CELL3_VOLT_RES;
    ADC_history[ADC_CELL4_VOLT_INDEX][ADC_filt.i_sample] =  ADC_CELL4_VOLT_RES;
    //Then sum but change to sum the one in history not the one measured
    ADC_filt.sum[ADC_CELL2_CUR_INDEX] += ADC_history[ADC_CELL2_CUR_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL1_CUR_INDEX] += ADC_history[ADC_CELL1_CUR_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL3_CUR_INDEX] += ADC_history[ADC_CELL3_CUR_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL4_CUR_INDEX] += ADC_history[ADC_CELL4_CUR_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL1_VOLT_INDEX] += ADC_history[ADC_CELL1_VOLT_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL2_VOLT_INDEX] += ADC_history[ADC_CELL2_VOLT_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL3_VOLT_INDEX] += ADC_history[ADC_CELL3_VOLT_INDEX][ADC_filt.i_sample];
    ADC_filt.sum[ADC_CELL4_VOLT_INDEX] += ADC_history[ADC_CELL4_VOLT_INDEX][ADC_filt.i_sample];
    

    #if (TRIMMED_MEAN_ADC == 1)  
  
    for (i = 0; i < 10; i++) {

    //      if ((ADC_history[ADC_CELL2_CUR_INDEX][i]) < min1[ADC_CELL2_CUR_INDEX]) {                                                \
    //      min2[ADC_CELL2_CUR_INDEX] = min1[ADC_CELL2_CUR_INDEX];                                            \
    //      min1[ADC_CELL2_CUR_INDEX] = ADC_history[ADC_CELL2_CUR_INDEX][i];                                                  \
    // } else if ((ADC_history[ADC_CELL2_CUR_INDEX][i]) < min2[ADC_CELL2_CUR_INDEX]) {                                         \
    //     min2[ADC_CELL2_CUR_INDEX] = (ADC_history[ADC_CELL2_CUR_INDEX][i]);                                                  \
    // }                                                                         \
    // if ((ADC_history[ADC_CELL2_CUR_INDEX][i]) > max1[ADC_CELL2_CUR_INDEX]) {                                                \
    //     max2[ADC_CELL2_CUR_INDEX] = max1[ADC_CELL2_CUR_INDEX];                                            \
    //     max1[ADC_CELL2_CUR_INDEX] = (ADC_history[ADC_CELL2_CUR_INDEX][i]);                                                  \
    // } else if ((ADC_history[ADC_CELL2_CUR_INDEX][i]) > max2[ADC_CELL2_CUR_INDEX]) {                                         \
    //     max2[ADC_CELL2_CUR_INDEX] = (ADC_history[ADC_CELL2_CUR_INDEX][i]);                                                  \
    // }
    
        //update_min_max(i, ADC_CELL2_CUR_INDEX);
        //update_min_max(i, ADC_CELL1_CUR_INDEX);
        //update_min_max(i, ADC_CELL3_CUR_INDEX);
        //update_min_max(i, ADC_CELL4_CUR_INDEX);
        update_min_max(i, ADC_CELL1_VOLT_INDEX);
        update_min_max(i, ADC_CELL2_VOLT_INDEX);
        //update_min_max(i, ADC_CELL3_VOLT_INDEX);
        update_min_max(i, ADC_CELL4_VOLT_INDEX);

    } 
#endif


    ADC_filt.i_sample++;

    if (ADC_filt.i_sample == ADC_PWM_RAT/2) // Ensure deterministic sampling -- average is updated only in the middle or the first sample before middle (for the case ADC_PWM_RAT/2 is not integer)
    {
        #if (TRIMMED_MEAN_ADC !=1)
        ADC_filt.avg[ADC_CELL1_CUR_INDEX] = (ADC_filt.sum[ADC_CELL1_CUR_INDEX]) * (1./ADC_PWM_RAT);
        ADC_filt.avg[ADC_CELL2_CUR_INDEX] = (ADC_filt.sum[ADC_CELL2_CUR_INDEX]) * (1./ADC_PWM_RAT);
        ADC_filt.avg[ADC_CELL3_CUR_INDEX] = (ADC_filt.sum[ADC_CELL3_CUR_INDEX]) * (1./ADC_PWM_RAT);
        ADC_filt.avg[ADC_CELL4_CUR_INDEX] = (ADC_filt.sum[ADC_CELL4_CUR_INDEX]) * (1./ADC_PWM_RAT);
        #else
        ADC_filt.avg[ADC_CELL1_CUR_INDEX] = (ADC_filt.sum[ADC_CELL1_CUR_INDEX] - ADC_filt.min1[ADC_CELL1_CUR_INDEX] - ADC_filt.min2[ADC_CELL1_CUR_INDEX] - ADC_filt.max1[ADC_CELL1_CUR_INDEX] - ADC_filt.max2[ADC_CELL1_CUR_INDEX]) * (1. / (ADC_PWM_RAT));
        ADC_filt.avg[ADC_CELL2_CUR_INDEX] = (ADC_filt.sum[ADC_CELL2_CUR_INDEX] - ADC_filt.min1[ADC_CELL2_CUR_INDEX] - ADC_filt.min2[ADC_CELL2_CUR_INDEX] - ADC_filt.max1[ADC_CELL2_CUR_INDEX] - ADC_filt.max2[ADC_CELL2_CUR_INDEX]) * (1. / (ADC_PWM_RAT));
        ADC_filt.avg[ADC_CELL3_CUR_INDEX] = (ADC_filt.sum[ADC_CELL3_CUR_INDEX] - ADC_filt.min1[ADC_CELL3_CUR_INDEX] - ADC_filt.min2[ADC_CELL3_CUR_INDEX] - ADC_filt.max1[ADC_CELL3_CUR_INDEX] - ADC_filt.max2[ADC_CELL3_CUR_INDEX]) * (1. / (ADC_PWM_RAT));
        ADC_filt.avg[ADC_CELL4_CUR_INDEX] = (ADC_filt.sum[ADC_CELL4_CUR_INDEX] - ADC_filt.min1[ADC_CELL4_CUR_INDEX] - ADC_filt.min2[ADC_CELL4_CUR_INDEX] - ADC_filt.max1[ADC_CELL4_CUR_INDEX] - ADC_filt.max2[ADC_CELL4_CUR_INDEX]) * (1. / (ADC_PWM_RAT));
        #endif
        
#if (ALLOW_VOLT_MOV_MEAN != 1)
#if (TRIMMED_MEAN_ADC !=1)
        ADC_filt.avg[ADC_CELL1_VOLT_INDEX] = ADC_filt.sum[ADC_CELL1_VOLT_INDEX] * (1./ADC_PWM_RAT);
        ADC_filt.avg[ADC_CELL2_VOLT_INDEX] = ADC_filt.sum[ADC_CELL2_VOLT_INDEX] * (1./ADC_PWM_RAT);
        ADC_filt.avg[ADC_CELL3_VOLT_INDEX] = ADC_filt.sum[ADC_CELL3_VOLT_INDEX] * (1./ADC_PWM_RAT);
        ADC_filt.avg[ADC_CELL4_VOLT_INDEX] = ADC_filt.sum[ADC_CELL4_VOLT_INDEX] * (1./ADC_PWM_RAT);
#else
        ADC_filt.avg[ADC_CELL1_VOLT_INDEX] = (ADC_filt.sum[ADC_CELL1_VOLT_INDEX] - ADC_filt.min1[ADC_CELL1_VOLT_INDEX] - ADC_filt.min2[ADC_CELL1_VOLT_INDEX] - ADC_filt.max1[ADC_CELL1_VOLT_INDEX] - ADC_filt.max2[ADC_CELL1_VOLT_INDEX]) * (1. / (ADC_PWM_RAT - 4));
        ADC_filt.avg[ADC_CELL2_VOLT_INDEX] = (ADC_filt.sum[ADC_CELL2_VOLT_INDEX] - ADC_filt.min1[ADC_CELL2_VOLT_INDEX] - ADC_filt.min2[ADC_CELL2_VOLT_INDEX] - ADC_filt.max1[ADC_CELL2_VOLT_INDEX] - ADC_filt.max2[ADC_CELL2_VOLT_INDEX]) * (1. / (ADC_PWM_RAT - 4));
        ADC_filt.avg[ADC_CELL3_VOLT_INDEX] = (ADC_filt.sum[ADC_CELL3_VOLT_INDEX] - ADC_filt.min1[ADC_CELL3_VOLT_INDEX] - ADC_filt.min2[ADC_CELL3_VOLT_INDEX] - ADC_filt.max1[ADC_CELL3_VOLT_INDEX] - ADC_filt.max2[ADC_CELL3_VOLT_INDEX]) * (1. / (ADC_PWM_RAT));
        ADC_filt.avg[ADC_CELL4_VOLT_INDEX] = (ADC_filt.sum[ADC_CELL4_VOLT_INDEX] - ADC_filt.min1[ADC_CELL4_VOLT_INDEX] - ADC_filt.min2[ADC_CELL4_VOLT_INDEX] - ADC_filt.max1[ADC_CELL4_VOLT_INDEX] - ADC_filt.max2[ADC_CELL4_VOLT_INDEX]) * (1. / (ADC_PWM_RAT - 4));
#endif // #if (TRIMMED_MEAN_ADC !=1)
#else
        // Make sure that index is not pointing outside the array
        if (mov_mean_index >= 4)
        {
            mov_mean_index = 0;
        }
        #if (TRIMMED_MEAN_ADC !=1)
        volt_mov_mean[0][mov_mean_index] = ADC_filt.sum[ADC_CELL1_VOLT_INDEX] * (1./ADC_PWM_RAT);
        volt_mov_mean[1][mov_mean_index] = ADC_filt.sum[ADC_CELL2_VOLT_INDEX] * (1./ADC_PWM_RAT);
        volt_mov_mean[2][mov_mean_index] = ADC_filt.sum[ADC_CELL3_VOLT_INDEX] * (1./ADC_PWM_RAT);
        volt_mov_mean[3][mov_mean_index] = ADC_filt.sum[ADC_CELL4_VOLT_INDEX] * (1./ADC_PWM_RAT);
        #else
        volt_mov_mean[0][mov_mean_index] = (ADC_filt.sum[ADC_CELL1_VOLT_INDEX] - ADC_filt.min1[ADC_CELL1_VOLT_INDEX] - ADC_filt.min2[ADC_CELL1_VOLT_INDEX] - ADC_filt.max1[ADC_CELL1_VOLT_INDEX] - ADC_filt.max2[ADC_CELL1_VOLT_INDEX]) * (1. / (ADC_PWM_RAT - 4));
        volt_mov_mean[1][mov_mean_index] = (ADC_filt.sum[ADC_CELL2_VOLT_INDEX] - ADC_filt.min1[ADC_CELL2_VOLT_INDEX] - ADC_filt.min2[ADC_CELL2_VOLT_INDEX] - ADC_filt.max1[ADC_CELL2_VOLT_INDEX] - ADC_filt.max2[ADC_CELL2_VOLT_INDEX]) * (1. / (ADC_PWM_RAT - 4));
        volt_mov_mean[2][mov_mean_index] = (ADC_filt.sum[ADC_CELL3_VOLT_INDEX] - ADC_filt.min1[ADC_CELL3_VOLT_INDEX] - ADC_filt.min2[ADC_CELL3_VOLT_INDEX] - ADC_filt.max1[ADC_CELL3_VOLT_INDEX] - ADC_filt.max2[ADC_CELL3_VOLT_INDEX]) * (1. / (ADC_PWM_RAT));
        volt_mov_mean[3][mov_mean_index] = (ADC_filt.sum[ADC_CELL4_VOLT_INDEX] - ADC_filt.min1[ADC_CELL4_VOLT_INDEX] - ADC_filt.min2[ADC_CELL4_VOLT_INDEX] - ADC_filt.max1[ADC_CELL4_VOLT_INDEX] - ADC_filt.max2[ADC_CELL4_VOLT_INDEX]) * (1. / (ADC_PWM_RAT - 4));
        #endif
        ADC_filt.avg[ADC_CELL1_VOLT_INDEX] = mov_mean(&volt_mov_mean[0][0]);
        ADC_filt.avg[ADC_CELL2_VOLT_INDEX] = mov_mean(&volt_mov_mean[1][0]);
        ADC_filt.avg[ADC_CELL3_VOLT_INDEX] = mov_mean(&volt_mov_mean[2][0]);
        ADC_filt.avg[ADC_CELL4_VOLT_INDEX] = mov_mean(&volt_mov_mean[3][0]);
        mov_mean_index++;


#endif
    }
    if (ADC_filt.i_sample == ADC_PWM_RAT)
    {
        ADC_filt.i_sample = 0;
    }

    //EPWM_ADC_CLA_TIMING_MODULE.ETCLR.bit.INT = 1;

    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;



}


